# Copy to server/.env and fill in real values. Never commit server/.env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Put the database name before the "?" e.g. .../portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/portfolio?retryWrites=true&w=majority&appName=portfolio

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
CLIENT_URL=http://localhost:5173

# Optional: contact form rate limit (default 5 messages per 15 minutes per IP)
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=900000
